PORT=3005
ALLOWED_ORIGINS=

# Les mêmes valeurs que nest-mongo-user, qui les génère.
# 64 caractères hexadécimaux exigés : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_USER_SECRET=
JWT_SERVICE_SECRET=
# Trousseau des clés maîtresses des clés d'agent : kid:hex64[,kid:hex64…].
# Le kid est celui saisi dans set-agent-key (nest-mongo-user). Validé au démarrage.
AGENT_ENCRYPTION_KEYS=
NEST_USER_SERVICE_URL=http://localhost:3001

# 43200000 = 12h
MARKET_REFRESH_INTERVAL_MS=43200000
